# Claude Code via Amazon Bedrock — à copier, jamais à committer rempli.
# Source : https://code.claude.com/docs/en/amazon-bedrock
# En flotte, préférez le bloc "env" de managed-settings.json à un export shell.

# Active le fournisseur Bedrock (obligatoire)
CLAUDE_CODE_USE_BEDROCK=1

# Région AWS. Pour une résidence UE, choisir une région eu-* (préfixe d'inférence eu.)
AWS_REGION=eu-west-3
# Force le préfixe des profils d'inférence inter-régions : us, eu, apac, jp, au, global
ANTHROPIC_BEDROCK_REGION_PREFIX=eu

# Authentification : profil SSO IAM Identity Center (recommandé)
AWS_PROFILE=claude-code
# Ou clé d'API Bedrock courte durée (≤ 12 h) — ne pas mettre la valeur ici
# AWS_BEARER_TOKEN_BEDROCK=

# Épinglage des modèles (obligatoire en déploiement d'équipe, cf. doc « Pin model versions »)
ANTHROPIC_DEFAULT_OPUS_MODEL=eu.anthropic.claude-opus-4-8
ANTHROPIC_DEFAULT_SONNET_MODEL=eu.anthropic.claude-sonnet-4-6
# Modèle par défaut moins coûteux
ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-6

# Passerelle ou point de terminaison privé (VPC endpoint), optionnel
# ANTHROPIC_BEDROCK_BASE_URL=https://bedrock-runtime.eu-west-3.amazonaws.com

# Niveau de service Bedrock : default, flex, priority
# ANTHROPIC_BEDROCK_SERVICE_TIER=default

# Guardrails Bedrock, optionnel
# ANTHROPIC_CUSTOM_HEADERS="X-Amzn-Bedrock-GuardrailIdentifier: <id>\nX-Amzn-Bedrock-GuardrailVersion: 1"

# Proxy d'entreprise et AC interne (https://code.claude.com/docs/en/network-config)
# HTTPS_PROXY=http://proxy.exemple.interne:8080
# NO_PROXY=localhost,.exemple.interne
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ac-entreprise.pem
