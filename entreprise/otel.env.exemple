# Télémétrie OpenTelemetry vers le collecteur interne — usage et coûts.
# Source : https://code.claude.com/docs/en/monitoring-usage
# À déployer via le bloc "env" de managed-settings.json : les variables d'export OTel
# sont ignorées dans .claude/settings.json et .claude/settings.local.json.

# Active la télémétrie (obligatoire)
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Exporteurs : otlp, prometheus, console, none
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Collecteur interne
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.exemple.interne:4317
# Jeton du collecteur : injecté par le MDM, jamais dans un fichier versionné
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <jeton>

# Intervalles d'export en ms (défauts : 60000 et 5000)
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_LOGS_EXPORT_INTERVAL=5000

# Attributs pour ventiler les coûts par équipe / centre de coût
OTEL_RESOURCE_ATTRIBUTES=departement=dsi,equipe=plateforme,centre.cout=CC1234

# Confidentialité : ne pas journaliser le contenu des prompts ni les paramètres d'outils (défaut : désactivé)
OTEL_LOG_USER_PROMPTS=0
OTEL_LOG_TOOL_DETAILS=0

# Cardinalité des métriques
OTEL_METRICS_INCLUDE_SESSION_ID=true
OTEL_METRICS_INCLUDE_VERSION=true
OTEL_METRICS_INCLUDE_ACCOUNT_UUID=true

# Métriques utiles côté tableau de bord :
#   claude_code.cost.usage (USD), claude_code.token.usage, claude_code.session.count,
#   claude_code.lines_of_code.count, claude_code.pull_request.count, claude_code.commit.count,
#   claude_code.code_edit_tool.decision, claude_code.active_time.total
# Événements (logs) : claude_code.user_prompt, claude_code.tool_decision,
#   claude_code.api_request, claude_code.api_error
