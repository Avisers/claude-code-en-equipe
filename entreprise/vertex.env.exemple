# Claude Code via Google Cloud Agent Platform (ex-Vertex AI) — à copier, jamais à committer rempli.
# Source : https://code.claude.com/docs/en/google-vertex-ai

# Active le fournisseur Vertex (obligatoire)
CLAUDE_CODE_USE_VERTEX=1

# Projet GCP dédié (facilite le suivi des coûts)
ANTHROPIC_VERTEX_PROJECT_ID=mon-projet-claude-code

# Région : global, multirégion (eu, us) ou région précise.
# Pour une résidence UE : "eu" (hôte aiplatform.eu.rep.googleapis.com) ou une région europe-*
CLOUD_ML_REGION=eu
# Surcharge par modèle si le modèle n'est pas servi dans CLOUD_ML_REGION
# VERTEX_REGION_CLAUDE_HAIKU_4_5=europe-west1
# VERTEX_REGION_CLAUDE_4_6_SONNET=europe-west1

# Authentification : Application Default Credentials (gcloud auth application-default login)
# ou fichier de fédération d'identité / compte de service, hors dépôt
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/hors-depot/credentials.json

# Épinglage des modèles (obligatoire en déploiement d'équipe)
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Point de terminaison personnalisé ou passerelle, optionnel
# ANTHROPIC_VERTEX_BASE_URL=https://aiplatform.googleapis.com

# Proxy d'entreprise et AC interne
# HTTPS_PROXY=http://proxy.exemple.interne:8080
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ac-entreprise.pem
